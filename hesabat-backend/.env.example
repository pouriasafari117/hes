# Database Connection
# PostgreSQL 12+ (Local یا Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/hesabat

# JWT Configuration
# تولید با: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long-and-unique
JWT_EXPIRES=7d

# Server Configuration
NODE_ENV=development
PORT=3000
PANEL_PORT=8000

# CORS (درخواست‌های cross-origin)
CORS_ORIGIN=http://localhost:8000

# Backend URL (برای Panel)
BACKEND_URL=http://localhost:3000
