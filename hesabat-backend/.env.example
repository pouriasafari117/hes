# نمونه برای لوکال
# DATABASE_URL=postgres://hesabat_app:hesabat_app_pass@localhost:5432/hesabat
# PORT=4000
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES=7d
# CORS_ORIGIN=*

# نمونه برای دیپلوی رایگان همیشگی (Supabase + Render):
# DATABASE_URL را از Supabase > Project Settings > Database > Connection String > URI (Session pooler) کپی کن
# مثال: postgres://postgres.xxxxx:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# یا Direct: postgres://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
PORT=10000
JWT_SECRET=یک-رشته-خیلی-بلند-تصادفی-حداقل-32-کاراکتر-اینجا-بگذار
JWT_EXPIRES=7d
CORS_ORIGIN=*

# روشن‌کردن مسیر /api/debug فقط برای عیب‌یابی (پیش‌فرض خاموش)
# ENABLE_DEBUG=1
# حالت اجرا (production برای هشدارهای امنیتی)
# NODE_ENV=production
